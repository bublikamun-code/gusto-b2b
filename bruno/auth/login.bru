meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

docs {
  При включённой 2FA добавить "totpCode": "123456".
  Refresh-токен приходит в httpOnly-куке (Bruno хранит куки автоматически).
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", res.getBody().data.accessToken);
  }
}
