meta {
  name: 2FA verify
  type: http
  seq: 7
}

post {
  url: {{host}}/api/v1/auth/2fa/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "code": "{{totpCode}}"
  }
}

docs {
  Укажите текущий 6-значный код из TOTP-приложения в переменной `totpCode`.
}
