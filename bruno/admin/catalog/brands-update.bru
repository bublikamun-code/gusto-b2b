meta {
  name: Update brand
  type: http
  seq: 10
}

put {
  url: {{host}}/api/v1/admin/catalog/brands/{{createdBrandId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Бренд обновлённый {{$timestamp}}",
    "slug": "brand-{{$timestamp}}"
  }
}
