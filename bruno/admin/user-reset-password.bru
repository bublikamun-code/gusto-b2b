meta {
  name: Reset password
  type: http
  seq: 6
}

post {
  url: {{host}}/api/v1/admin/users/{{createdUserId}}/reset-password
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("temporaryPassword", res.getBody().data.temporaryPassword);
  }
}
