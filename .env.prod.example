# Шаблон секретов прода (S41). На сервере: `cp .env.prod.example .env.prod`
# в /srv/gusto и заполнить значения; файл не коммитится.

# --- БД ---
POSTGRES_USER=gusto
POSTGRES_PASSWORD=<сильный-пароль>
POSTGRES_DB=gusto

# --- Auth ---
JWT_SECRET=<64+ случайных символов: openssl rand -hex 32>
ADMIN_EMAIL=admin@gustomeat.by
ADMIN_PASSWORD=<пароль админа, меняется после первого входа>

# --- Домен / CORS ---
APP_BASE_URL=https://gustomeat.by
APP_CORS_ORIGINS=https://gustomeat.by,https://www.gustomeat.by

# --- Файлы ---
APP_STORAGE_PATH=/app/data/files

# --- Почта (боевой SMTP, S33) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Telegram (S32) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Бэкапы (infra/scripts/backup.sh) ---
# публичный ключ age (age-keygen); приватный ключ — ТОЛЬКО офлайн-хранилище
BACKUP_AGE_PUBLIC_KEY=age1...
BACKUP_DIR=/srv/backups
# сколько суточных копий держать
BACKUP_KEEP_DAYS=14
