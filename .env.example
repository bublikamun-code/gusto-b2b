# Доступы к БД (dev-значения; для прода — свои секреты)
POSTGRES_USER=gusto
POSTGRES_PASSWORD=gusto-dev
POSTGRES_DB=gusto

# Auth
JWT_SECRET=dev-only-replace-with-64-random-characters-before-production

# Seed админа (используется миграцией V2, пароль — bcrypt)
ADMIN_EMAIL=admin@gustomeat.by
ADMIN_PASSWORD=change-me

# Файловое хранилище (S17)
APP_STORAGE_PATH=./data/files

# База ссылок в письмах (подтверждение email — S08.1)
APP_BASE_URL=http://localhost:5173
# S40: CORS-allowlist API (через запятую); в проде добавить https://gustomeat.by
APP_CORS_ORIGINS=http://localhost:5173

# SMTP / Telegram (заполняются в S32–S33)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# Telegram-уведомления (S32): секрет вебхука бота
TELEGRAM_WEBHOOK_SECRET=

# ИИ-советник лендинга (S45). Любой OpenAI-совместимый endpoint.
# Без APP_AI_API_KEY блок рецептов работает, а чат отвечает детерминированным
# советником по каталогу рецептов — ключ нужен только для «живых» ответов.
# APP_AI_API_KEY=
# APP_AI_BASE_URL=https://api.openai.com
# APP_AI_MODEL=gpt-4o-mini
# APP_AI_REQUESTS_PER_HOUR=20
